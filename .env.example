# MongoDB Atlas connection string
MONGODB_URI=

# Auth.js v5 session-signing secret — generate with `openssl rand -base64 32`
AUTH_SECRET=

# Used only by `pnpm seed` to create the initial admin account
SEED_ADMIN_EMAIL=admin@thecraftsync.local
SEED_ADMIN_PASSWORD=

# Shared secret for POST /api/v1/tickets (service-to-service integrations, e.g. DroneSeva's
# garbage-detection pipeline). Same value goes in the calling app as TCS_TICKET_API_KEY.
INTEGRATION_API_KEY=

# Origin of the DroneSeva portal — used to rewrite "View in DroneSeva" ticket links to wherever
# the portal currently runs, regardless of what port it was on when the ticket was created.
DRONESEVA_PORTAL_ORIGIN=http://localhost:3010

# Cloudinary — image uploads on ticket comments. Get these from the Cloudinary console
# (Dashboard > Product Environment Settings > API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Zone Inspector location check: how close (metres) the inspector must be to the ticket's spot for a
# photo to count, and how rough a phone location reading may be. Defaults shown.
# RESOLVE_RADIUS_METERS=10
# RESOLVE_MAX_ACCURACY_METERS=20

# Garbage check on Zone Inspector cleanup photos: the address of the detection service (Drone-Seva's
# python sidecar, e.g. http://127.0.0.1:8001). Leave empty to switch the check off. A photo is
# accepted when garbage covers LESS than PHOTO_MAX_GARBAGE_PERCENT of it (default 5). With
# PHOTO_CHECK_STRICT=true a photo is refused when the service cannot be reached.
# PHOTO_CHECK_URL=http://127.0.0.1:8001
# PHOTO_CHECK_KEY=
# PHOTO_MAX_GARBAGE_PERCENT=5
# PHOTO_MAX_ITEMS=5
# PHOTO_CHECK_STRICT=false
