# MongoDB Atlas connection string
MONGODB_URI=

# Auth.js v5 session-signing secret — generate with `openssl rand -base64 32`
AUTH_SECRET=

# Used only by `pnpm seed` to create the initial admin account
SEED_ADMIN_EMAIL=admin@thecraftsync.local
SEED_ADMIN_PASSWORD=

# Shared secret for POST /api/v1/tickets (service-to-service integrations, e.g. DroneSeva's
# garbage-detection pipeline). Same value goes in the calling app as TCS_TICKET_API_KEY.
INTEGRATION_API_KEY=

# Origin of the DroneSeva portal — used to rewrite "View in DroneSeva" ticket links to wherever
# the portal currently runs, regardless of what port it was on when the ticket was created.
DRONESEVA_PORTAL_ORIGIN=http://localhost:3010
